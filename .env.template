# Every variable this repo reads - the app at build time and the compose stack
# at start-up (CORE-023). Copy to `.env` and fill in; `.env` is untracked.
#
#   cp .env.template .env
#
# Nothing here is secret: every value ends up in the browser.

# === Application ============================================================

# Backend API base URL, used by `npm run dev` / `npm run build` and by static
# hosts such as Vercel. Read at BUILD time and inlined into the bundle, so
# changing it needs a rebuild.
#
# The Docker image ignores this and reads API_URL at start-up instead (see
# below), which is what lets one image serve every environment.
VITE_API_URL=http://localhost:8000/

# Where the live websocket endpoints (/ws/live, /ws/matches/{id}) are served
# from. They are part of the API, so this DEFAULTS TO VITE_API_URL - set it only
# if they are ever moved to another host. http(s) is converted to ws(s) by the
# app. The literal value `off` disables the websocket: the live pages then poll
# the API every 10 s instead.
VITE_LIVE_URL=

# === Docker stack ===========================================================
# Read by docker-compose.yml / env.yml / port_forwards.yml.

# Names the container, the network and the compose project, so several
# environments can share one host: local / testing / staging / production.
ENV=local

# Image to run. Empty = build locally from this checkout and tag it
# students-community-championship-frontend:${APP_VERSION}. A deployment sets the
# immutable tag produced by scripts/build-image.sh, e.g.
# WEB_IMAGE=registry.example.eu/scc/frontend:sha-ab12cd3
WEB_IMAGE=
APP_VERSION=local

# Public URL of the API, written into /runtime-config.js when the container
# starts. The BROWSER calls it, so it must be an address the browser can reach -
# never a container name. This frontend's own origin must appear in the
# backend's ALLOWED_ORIGINS, or CORS blocks every request.
API_URL=http://localhost:8000/
# Where the live websocket endpoints are served from, written into
# /runtime-config.js the same way. Empty = same host as API_URL (the default,
# they are part of the API); `off` = no websocket, the pages poll instead.
LIVE_URL=

# --- Published ports (port_forwards.yml) ------------------------------------
WEB_PORT=3000
